# Copy to .env at the repo root and fill in. Never commit .env.
# Sandbox REST app: developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Decision log location, relative to backend/
DATABASE_PATH=payguard.db

# Comma-separated merchant IDs of payees the store knows (the demo merchant).
# sandbox_smoke prints the ID for your account.
ALLOWED_MERCHANT_IDS=

# Lets the demo run attack scenarios (a poisoned product page, a lookalike seller).
# Never true outside a demo.
DEMO_ATTACKS_ENABLED=true

# OpenAI API key (platform.openai.com > API keys). Reads requests and runs the shopping agent.
LLM_API_KEY=
# Optional model overrides. Defaults: gpt-5.5 reads requests, gpt-5.4-mini shops.
MANDATE_MODEL=
AGENT_MODEL=

# Email of a second sandbox business account, named "Trai1head Running" (a digit 1),
# that plays the lookalike seller in the lookalike scenario.
DEMO_LOOKALIKE_PAYEE=
